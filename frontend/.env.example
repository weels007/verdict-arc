# VerdictArc frontend configuration.
#
# These are BUILD-TIME variables — baked into the bundle when
# `npm run build` runs. On Vercel, set them as Project Environment
# Variables (Settings → Environment Variables) and redeploy.
# Do NOT put real secrets in this file.
#
# ── Local development ──────────────────────────────────────────
# Copy this file to frontend/.env for local development against
# a simulator or testnet. Do NOT commit frontend/.env.
#
# ── Vercel deployment ──────────────────────────────────────────
# Set these as Project Environment Variables in the Vercel dashboard:
#   VITE_GENLAYER_ENDPOINT  →  public GenLayer testnet RPC URL
#   VITE_GENLAYER_CONTRACT  →  deployed contract address
# Then redeploy. No localhost in production.

# GenLayer RPC endpoint the browser talks to.
# Studio-next preview (studio-dev) by default — must be reachable
# from visitors' browsers (Studio URL works publicly).
# Stable Studio: https://studio.genlayer.com/api
# Local dev: http://localhost:8080/api
VITE_GENLAYER_ENDPOINT=https://studio-dev.genlayer.com/api

# Deployed VerdictArc contract address (from `npm run deploy` output).
VITE_GENLAYER_CONTRACT=0x00000000000000000000000000000000000000
