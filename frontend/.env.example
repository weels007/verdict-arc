# VerdictArc frontend configuration.
#
# These are BUILD-TIME variables: they are baked into the bundle when
# `npm run build` runs. On Vercel, set them as Project Environment Variables
# (Settings → Environment Variables) and redeploy — do not put real addresses
# in this file.
#
# Copy to frontend/.env only for local development against a local simulator.

# GenLayer RPC endpoint the browser talks to — Studio-next preview by default.
# Must be reachable from visitors' browsers (Studio URL works publicly).
# Stable Studio: https://studio.genlayer.com/api — Local dev: http://localhost:8080/api
VITE_GENLAYER_ENDPOINT=https://studio-dev.genlayer.com/api

# Deployed VerdictArc contract address (from `npm run deploy` output).
VITE_GENLAYER_CONTRACT=0x0000000000000000000000000000000000000000
